---
const skills = {
  marketing: ['Marketing Strategy', 'Content', 'Facebook Ads', 'TikTok', 'SEO', 'Branding', 'Video'],
  technology: ['Web Development', 'System Design', 'Database', 'Google Apps Script', 'AI', 'Data'],
  planning: ['Campaign Planning', 'Project Planning', 'Creative Planning']
};

const projects = [
  {
    number: '01',
    title: 'Thuận Hưng Website',
    category: 'WEB DEVELOPMENT / MARKETING / BRANDING',
    description: 'Xây dựng và phát triển website cho Trung tâm Ngoại ngữ và Tư vấn Du học Thuận Hưng, kết hợp mục tiêu thương hiệu, nội dung và trải nghiệm người dùng.',
    image: '/images/projects/project-01.jpg',
    tone: 'crimson'
  },
  {
    number: '02',
    title: 'Academic Reporting System',
    category: 'SYSTEM DESIGN / DATABASE / DATA',
    description: 'Hệ thống hỗ trợ báo cáo và quản lý dữ liệu học vụ, hướng tới việc giảm thao tác thủ công và chuẩn hóa quy trình báo cáo.',
    image: '/images/projects/project-02.jpg',
    tone: 'navy'
  },
  {
    number: '03',
    title: 'Debt Management System',
    category: 'SYSTEM DESIGN / DATABASE / AUTOMATION',
    description: 'Hệ thống quản lý công nợ phục vụ vận hành nội bộ, tập trung vào theo dõi giao dịch, trạng thái thanh toán và dữ liệu quản lý.',
    image: '/images/projects/project-03.jpg',
    tone: 'light'
  },
  {
    number: '04',
    title: 'Thuận Hưng Branding',
    category: 'BRAND STRATEGY / CONTENT / CREATIVE',
    description: 'Định hướng hình ảnh, nội dung và hoạt động truyền thông nhằm xây dựng nhận diện Thuận Hưng nhất quán trên các nền tảng.',
    image: '/images/projects/project-04.jpg',
    tone: 'crimson'
  }
];

const lifePhotos = [
  { src: '/images/life/life-01.jpg', alt: 'Work moment', caption: 'Work mode.' },
  { src: '/images/life/life-02.jpg', alt: 'Travel moment', caption: 'A little escape.' },
  { src: '/images/life/life-03.jpg', alt: 'Everyday moment', caption: 'Another ordinary day.' },
  { src: '/images/life/life-04.jpg', alt: 'Travel moment', caption: 'Keep moving.' },
  { src: '/images/life/life-05.jpg', alt: 'Everyday moment', caption: 'Small moments.' }
];
---

<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#080808" />
    <meta name="description" content="Nguyễn Minh Nguyên — Nathan. Marketing × IT × Planning. Personal portfolio and life journal." />
    <meta property="og:title" content="Nathan — Nguyễn Minh Nguyên" />
    <meta property="og:description" content="Marketing × IT × Planning. I build ideas, systems and experiences." />
    <meta property="og:type" content="website" />
    <title>Nathan — Nguyễn Minh Nguyên</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="site-header" id="top">
      <a class="brand" href="#top" aria-label="Nathan home">NATHAN<span>.</span></a>
      <nav class="desktop-nav" aria-label="Main navigation">
        <a href="#about">ABOUT</a>
        <a href="#work">WORK</a>
        <a href="#projects">PROJECTS</a>
        <a href="#life">LIFE</a>
        <a href="#contact">CONTACT</a>
      </nav>
      <a class="header-cta" href="mailto:minhnguyennguyen2107@gmail.com">LET'S TALK <span>↗</span></a>
      <button class="menu-toggle" aria-label="Open menu" aria-expanded="false">☰</button>
    </header>

    <div class="mobile-menu" aria-hidden="true">
      <a href="#about">ABOUT</a>
      <a href="#work">WORK</a>
      <a href="#projects">PROJECTS</a>
      <a href="#life">LIFE</a>
      <a href="#contact">CONTACT</a>
    </div>

    <main>
      <section class="hero section-pad" id="hero">
        <div class="hero-copy reveal">
          <p class="eyebrow"><span></span> HELLO, I'M</p>
          <h1>NGUYỄN<br />MINH<br /><em>NGUYÊN.</em></h1>
          <div class="hero-meta">
            <p class="name-tag">NATHAN</p>
            <p>MARKETING <b>×</b> IT <b>×</b> PLANNING</p>
          </div>
          <p class="hero-line">I build ideas, systems and experiences.</p>
          <a class="primary-btn" href="#projects">EXPLORE MY WORK <span>↓</span></a>
        </div>
        <div class="hero-visual reveal delay-1">
          <div class="navy-shape"></div>
          <div class="portrait-frame">
            <img src="/images/profile/profile.jpg" alt="Nguyễn Minh Nguyên — Nathan" />
            <div class="portrait-placeholder">YOUR<br />PHOTO</div>
          </div>
          <div class="vertical-label">MARKETING · TECHNOLOGY · CREATIVE</div>
        </div>
        <div class="scroll-note">SCROLL TO EXPLORE <span>↓</span></div>
      </section>

      <section class="about section-pad" id="about">
        <div class="section-heading reveal"><span>01</span><h2>ABOUT ME</h2></div>
        <div class="about-grid">
          <div class="about-copy reveal">
            <p class="lead">Tôi là <strong>Nguyễn Minh Nguyên — Nathan.</strong></p>
            <p>Tôi làm việc ở giao điểm giữa Marketing, Technology và Planning. Tôi thích biến những ý tưởng còn nằm trên giấy thành những chiến dịch, hệ thống và sản phẩm có thể vận hành trong thực tế.</p>
            <p>Tôi tin rằng một ý tưởng tốt không chỉ cần sáng tạo, mà còn cần được xây dựng đủ tốt để tạo ra giá trị.</p>
          </div>
          <div class="about-facts reveal delay-1">
            <div><span>01</span><strong>MARKETING</strong><small>Strategy · Content · Branding</small></div>
            <div><span>02</span><strong>TECHNOLOGY</strong><small>Web · System · Data · AI</small></div>
            <div><span>03</span><strong>PLANNING</strong><small>Campaign · Project · Creative</small></div>
            <div><span>04</span><strong>BASED IN VIETNAM</strong><small>Building from ideas to reality.</small></div>
          </div>
        </div>
      </section>

      <section class="work section-pad" id="work">
        <div class="section-heading reveal"><span>02</span><h2>WHAT I DO</h2></div>
        <div class="work-list">
          {Object.entries({ MARKETING: skills.marketing, TECHNOLOGY: skills.technology, PLANNING: skills.planning }).map(([title, items], index) => (
            <article class="work-row reveal" style={`--i:${index}`}>
              <div class="work-index">0{index + 1}</div>
              <div class="work-main"><h3>{title}</h3><p>{items.join(' · ')}</p></div>
              <span class="work-arrow">↗</span>
            </article>
          ))}
        </div>
      </section>

      <section class="projects section-pad" id="projects">
        <div class="projects-intro reveal">
          <div class="section-heading"><span>03</span><h2>SELECTED WORK</h2></div>
          <p>Some things I've built.</p>
        </div>
        <div class="project-list">
          {projects.map((project, index) => (
            <article class={`project project-${project.tone} reveal`}>
              <div class="project-image">
                <img src={project.image} alt={project.title} loading={index === 0 ? 'eager' : 'lazy'} />
                <div class="project-placeholder">PROJECT {project.number}</div>
              </div>
              <div class="project-info">
                <div class="project-top"><span>{project.number}</span><span>{project.category}</span></div>
                <h3>{project.title}</h3>
                <p>{project.description}</p>
                <a href="#contact">DISCUSS THIS PROJECT <span>↗</span></a>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="life section-pad" id="life">
        <div class="life-intro reveal">
          <div class="section-heading"><span>04</span><h2>LIFE</h2></div>
          <h3>A collection of<br /><em>ordinary moments.</em></h3>
          <p>Work. Travel. Everyday moments.</p>
        </div>
        <div class="life-grid">
          {lifePhotos.map((photo, index) => (
            <button class={`life-item life-item-${index + 1} reveal`} data-lightbox-src={photo.src} data-lightbox-alt={photo.alt} aria-label={`View ${photo.alt}`}>
              <img src={photo.src} alt={photo.alt} loading="lazy" />
              <div class="life-placeholder">PHOTO {String(index + 1).padStart(2, '0')}</div>
              <span>{photo.caption}</span>
            </button>
          ))}
        </div>
      </section>

      <section class="statement">
        <div class="statement-inner reveal">
          <span>PERSONAL NOTE</span>
          <h2>Ideas are easy.<br /><em>Building them is what matters.</em></h2>
        </div>
      </section>

      <section class="contact section-pad" id="contact">
        <div class="section-heading reveal"><span>05</span><h2>LET'S CONNECT</h2></div>
        <div class="contact-grid">
          <div class="contact-copy reveal">
            <h3>Have an idea?<br /><em>Let's build something together.</em></h3>
            <a class="email-link" href="mailto:minhnguyennguyen2107@gmail.com">minhnguyennguyen2107@gmail.com <span>↗</span></a>
          </div>
          <div class="contact-links reveal delay-1">
            <a href="https://www.facebook.com/mingyuan.2107" target="_blank" rel="noreferrer"><span>01</span> FACEBOOK <b>↗</b></a>
            <div class="disabled-link"><span>02</span> GITHUB <small>COMING SOON</small></div>
            <div class="disabled-link"><span>03</span> LINKEDIN <small>COMING SOON</small></div>
            <div class="disabled-link"><span>04</span> TIKTOK <small>COMING SOON</small></div>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div><strong>NATHAN<span>.</span></strong><p>NGUYỄN MINH NGUYÊN<br />MARKETING × IT × PLANNING</p></div>
      <div class="footer-right"><p>© 2026</p><a href="#top">BACK TO TOP ↑</a></div>
    </footer>

    <div class="lightbox" aria-hidden="true">
      <button class="lightbox-close" aria-label="Close image">×</button>
      <img src="" alt="" />
      <p></p>
    </div>

    <script>
      const header = document.querySelector('.site-header');
      const menuToggle = document.querySelector('.menu-toggle');
      const mobileMenu = document.querySelector('.mobile-menu');

      window.addEventListener('scroll', () => {
        header.classList.toggle('scrolled', window.scrollY > 30);
      }, { passive: true });

      menuToggle?.addEventListener('click', () => {
        const open = menuToggle.getAttribute('aria-expanded') === 'true';
        menuToggle.setAttribute('aria-expanded', String(!open));
        mobileMenu.classList.toggle('open', !open);
        mobileMenu.setAttribute('aria-hidden', String(open));
      });

      mobileMenu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
        menuToggle.setAttribute('aria-expanded', 'false');
        mobileMenu.classList.remove('open');
        mobileMenu.setAttribute('aria-hidden', 'true');
      }));

      const revealObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            revealObserver.unobserve(entry.target);
          }
        });
      }, { threshold: 0.12 });
      document.querySelectorAll('.reveal').forEach((el) => revealObserver.observe(el));

      const lightbox = document.querySelector('.lightbox');
      const lightboxImg = lightbox?.querySelector('img');
      const lightboxCaption = lightbox?.querySelector('p');
      const closeLightbox = () => {
        lightbox?.classList.remove('open');
        lightbox?.setAttribute('aria-hidden', 'true');
      };
      document.querySelectorAll('[data-lightbox-src]').forEach((item) => item.addEventListener('click', () => {
        if (!lightbox || !lightboxImg) return;
        lightboxImg.src = item.dataset.lightboxSrc || '';
        lightboxImg.alt = item.dataset.lightboxAlt || '';
        lightboxCaption.textContent = item.querySelector('span')?.textContent || '';
        lightbox.classList.add('open');
        lightbox.setAttribute('aria-hidden', 'false');
      }));
      document.querySelector('.lightbox-close')?.addEventListener('click', closeLightbox);
      lightbox?.addEventListener('click', (event) => { if (event.target === lightbox) closeLightbox(); });
      document.addEventListener('keydown', (event) => { if (event.key === 'Escape') closeLightbox(); });
    </script>
  </body>
</html>

<style>
  :root {
    --black: #080808;
    --surface: #111111;
    --white: #f5f5f5;
    --muted: #8a8a8a;
    --border: #252525;
    --crimson: #dc143c;
    --navy: #0b1f3a;
    --navy-light: #163a63;
    --max: 1440px;
    font-family: 'Be Vietnam Pro', 'Segoe UI', Arial, sans-serif;
    color-scheme: dark;
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body { margin: 0; background: var(--black); color: var(--white); font-family: inherit; line-height: 1.65; overflow-x: hidden; }
  body, button, a { font-family: inherit; }
  a { color: inherit; text-decoration: none; }
  button { color: inherit; font: inherit; }
  .site-header { position: fixed; z-index: 100; top: 0; left: 0; right: 0; height: 82px; padding: 0 5vw; display: flex; align-items: center; justify-content: space-between; transition: .35s ease; }
  .site-header.scrolled { background: rgba(8,8,8,.9); backdrop-filter: blur(14px); border-bottom: 1px solid var(--border); }
  .brand { font-size: 19px; font-weight: 800; letter-spacing: -.04em; }
  .brand span, .site-footer strong span { color: var(--crimson); }
  .desktop-nav { display: flex; gap: 30px; margin-left: auto; margin-right: 38px; }
  .desktop-nav a { font-size: 11px; font-weight: 700; letter-spacing: .14em; color: #bbb; transition: .25s; }
  .desktop-nav a:hover { color: var(--white); }
  .header-cta { border: 1px solid var(--crimson); padding: 11px 15px; font-size: 10px; font-weight: 700; letter-spacing: .12em; }
  .header-cta:hover { background: var(--crimson); }
  .menu-toggle { display: none; background: none; border: 0; font-size: 25px; cursor: pointer; }
  .mobile-menu { display: none; }
  .section-pad { max-width: var(--max); margin: 0 auto; padding: 150px 5vw; }
  .hero { min-height: 100vh; padding-top: 140px; display: grid; grid-template-columns: 1.05fr .95fr; align-items: center; position: relative; }
  .eyebrow, .section-heading span, .statement-inner > span { font-size: 11px; font-weight: 700; letter-spacing: .18em; color: var(--crimson); }
  .eyebrow { display: flex; gap: 12px; align-items: center; margin: 0 0 24px; }
  .eyebrow span { width: 34px; height: 1px; background: var(--crimson); }
  h1 { margin: 0; font-size: clamp(62px, 8.2vw, 128px); line-height: .82; letter-spacing: -.075em; font-weight: 800; }
  h1 em { color: var(--white); font-style: normal; text-shadow: 7px 7px 0 var(--crimson); }
  .hero-meta { margin-top: 35px; display: flex; gap: 25px; align-items: center; flex-wrap: wrap; }
  .hero-meta p { margin: 0; color: #aaa; font-size: 11px; letter-spacing: .14em; font-weight: 600; }
  .hero-meta .name-tag { color: var(--white); font-weight: 800; }
  .hero-meta b { color: var(--crimson); margin: 0 7px; }
  .hero-line { max-width: 390px; margin: 25px 0 32px; font-size: 18px; color: #ccc; }
  .primary-btn { display: inline-flex; align-items: center; gap: 30px; background: var(--crimson); padding: 16px 19px; font-size: 10px; font-weight: 800; letter-spacing: .13em; transition: transform .25s, background .25s; }
  .primary-btn:hover { transform: translateY(-3px); background: #f01b48; }
  .hero-visual { position: relative; min-height: 620px; display: grid; place-items: center; }
  .navy-shape { position: absolute; width: 70%; height: 78%; background: var(--navy); right: 5%; top: 12%; transform: rotate(4deg); }
  .portrait-frame { width: min(78%, 520px); aspect-ratio: 4 / 5; position: relative; background: #181818; overflow: hidden; border: 1px solid #303030; z-index: 1; }
  .portrait-frame img { width: 100%; height: 100%; object-fit: cover; display: block; filter: grayscale(100%); }
  .portrait-placeholder { position: absolute; inset: 0; display: grid; place-items: center; text-align: center; font-size: 24px; font-weight: 800; letter-spacing: .18em; color: #555; pointer-events: none; }
  .portrait-frame img[src$="profile.jpg"] { opacity: .18; }
  .vertical-label { position: absolute; z-index: 2; right: 0; bottom: 14%; writing-mode: vertical-rl; transform: rotate(180deg); font-size: 9px; letter-spacing: .22em; color: #777; }
  .scroll-note { position: absolute; bottom: 40px; left: 5vw; font-size: 9px; letter-spacing: .18em; color: #666; }
  .scroll-note span { color: var(--crimson); margin-left: 10px; }
  .section-heading { display: flex; gap: 20px; align-items: baseline; margin-bottom: 70px; }
  .section-heading h2 { font-size: clamp(38px, 5vw, 72px); letter-spacing: -.06em; line-height: 1; margin: 0; }
  .about { border-top: 1px solid var(--border); }
  .about-grid { display: grid; grid-template-columns: 1.15fr .85fr; gap: 10vw; }
  .about-copy { max-width: 720px; font-size: 16px; color: #aaa; }
  .about-copy .lead { color: var(--white); font-size: 29px; line-height: 1.35; }
  .about-copy strong { color: var(--white); }
  .about-facts { border-top: 1px solid var(--border); }
  .about-facts > div { display: grid; grid-template-columns: 40px 1fr; padding: 22px 0; border-bottom: 1px solid var(--border); }
  .about-facts span { color: var(--crimson); font-size: 10px; }
  .about-facts strong { font-size: 13px; letter-spacing: .08em; }
  .about-facts small { grid-column: 2; color: #777; margin-top: 2px; }
  .work { background: #0b0b0b; }
  .work-list { border-top: 1px solid var(--border); }
  .work-row { min-height: 160px; border-bottom: 1px solid var(--border); display: grid; grid-template-columns: 90px 1fr 50px; align-items: center; padding: 25px 0; transition: .3s; }
  .work-row:hover { background: var(--navy); padding-left: 24px; padding-right: 24px; }
  .work-index { color: var(--crimson); font-size: 11px; }
  .work-main h3 { margin: 0; font-size: clamp(28px, 4vw, 55px); letter-spacing: -.05em; }
  .work-main p { margin: 8px 0 0; color: #777; font-size: 12px; }
  .work-arrow { font-size: 26px; transition: .3s; }
  .work-row:hover .work-arrow { transform: translate(6px,-6px); color: var(--crimson); }
  .projects-intro { display: flex; align-items: end; justify-content: space-between; margin-bottom: 65px; }
  .projects-intro .section-heading { margin-bottom: 0; }
  .projects-intro > p { color: #777; font-size: 13px; }
  .project { margin-bottom: 130px; display: grid; grid-template-columns: 1.2fr .8fr; min-height: 500px; background: var(--surface); }
  .project:nth-child(even) { grid-template-columns: .8fr 1.2fr; }
  .project:nth-child(even) .project-image { order: 2; }
  .project-image { position: relative; overflow: hidden; min-height: 500px; background: #171717; }
  .project-image img { width: 100%; height: 100%; object-fit: cover; display: block; opacity: .24; filter: grayscale(100%); transition: transform .7s, opacity .5s; }
  .project:hover .project-image img { transform: scale(1.04); opacity: .42; }
  .project-placeholder { position: absolute; inset: 0; display: grid; place-items: center; font-size: 36px; font-weight: 800; color: #444; letter-spacing: .1em; }
  .project-info { padding: 55px; display: flex; flex-direction: column; justify-content: center; }
  .project-top { display: flex; justify-content: space-between; gap: 20px; font-size: 9px; letter-spacing: .12em; color: var(--crimson); }
  .project-info h3 { margin: 25px 0 18px; font-size: clamp(32px, 4vw, 58px); line-height: .95; letter-spacing: -.06em; }
  .project-info p { color: #888; max-width: 500px; font-size: 14px; }
  .project-info a { margin-top: 25px; font-size: 10px; font-weight: 800; letter-spacing: .12em; }
  .project-info a span { color: var(--crimson); margin-left: 12px; }
  .project-crimson .project-image { background: #2b0911; }
  .project-navy .project-image { background: var(--navy); }
  .project-light { background: var(--white); color: #090909; }
  .project-light .project-image { background: #ddd; }
  .project-light .project-info p, .project-light .project-top { color: #666; }
  .project-light .project-top span:first-child, .project-light .project-info a span { color: var(--crimson); }
  .life { border-top: 1px solid var(--border); }
  .life-intro { display: grid; grid-template-columns: 1fr 1fr; align-items: end; margin-bottom: 65px; }
  .life-intro .section-heading { grid-column: 1 / -1; }
  .life-intro h3 { font-size: clamp(38px, 5vw, 70px); line-height: .98; letter-spacing: -.06em; margin: 0; }
  .life-intro h3 em { color: var(--crimson); font-style: normal; }
  .life-intro > p { justify-self: end; color: #777; font-size: 13px; }
  .life-grid { display: grid; grid-template-columns: repeat(12, 1fr); gap: 15px; }
  .life-item { position: relative; border: 0; padding: 0; background: #151515; overflow: hidden; cursor: zoom-in; min-height: 290px; }
  .life-item img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; filter: grayscale(100%); opacity: .22; transition: .6s; }
  .life-item:hover img { transform: scale(1.05); filter: grayscale(0); opacity: .65; }
  .life-item span { position: absolute; left: 18px; bottom: 15px; color: white; font-size: 10px; letter-spacing: .1em; z-index: 2; }
  .life-placeholder { position: absolute; inset: 0; display: grid; place-items: center; color: #444; font-weight: 800; letter-spacing: .12em; font-size: 22px; }
  .life-item-1 { grid-column: span 4; }
  .life-item-2 { grid-column: span 8; min-height: 420px; }
  .life-item-3 { grid-column: 2 / span 5; }
  .life-item-4 { grid-column: 7 / span 6; }
  .life-item-5 { grid-column: 4 / span 6; min-height: 340px; }
  .statement { background: var(--crimson); color: #080808; padding: 150px 5vw; }
  .statement-inner { max-width: var(--max); margin: 0 auto; }
  .statement-inner > span { color: #080808; }
  .statement h2 { margin: 35px 0 0; font-size: clamp(48px, 7vw, 105px); line-height: .92; letter-spacing: -.075em; }
  .statement h2 em { color: white; font-style: normal; }
